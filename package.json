{
  "name": "xc-video-edit",
  "version": "0.1.1",
  "private": true,
  "description": "画面比例裁剪与等比重采样工具",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "snap": "electron tools/snap.js",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.xc.videoedit",
    "productName": "xcVideoEdit",
    "icon": "build/icon.ico",
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "portable"
      ]
    }
  }
}
